<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="电池与性能管家 · 无界14X Pro" Width="650" Height="720" MinWidth="600" MinHeight="610"
        Background="#191C24" Foreground="#EDF1F8" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF1F8"/><Setter Property="Margin" Value="0,4"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="16,9"/><Setter Property="Background" Value="#303C52"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF1F8"/><Setter Property="Margin" Value="0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#191C24"/><Setter Property="Foreground" Value="#EDF1F8"/><Setter Property="BorderBrush" Value="#455473"/><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A8B5CC"/><Setter Property="Padding" Value="21,10"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabBorder" Background="#222733" CornerRadius="8,8,0,0" Margin="0,0,4,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#33425D"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#242B38"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#A8B5CC"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,6"/></Style>
  </Window.Resources>
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="电池与性能管家" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="Supply" Text="正在读取供电状态" Foreground="#A7C5FF" FontSize="14"/></StackPanel>
    <TabControl x:Name="Tabs" Grid.Row="1" Background="#191C24" BorderThickness="0">
      <TabItem Header="性能"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0">
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock x:Name="Mode" Text="当前档位" FontSize="18" FontWeight="SemiBold"/>
          <UniformGrid Rows="1"><Button x:Name="Quiet" Content="节能"/><Button x:Name="Normal" Content="普通"/><Button x:Name="Performance" Content="性能"/></UniformGrid>
          <TextBlock Text="FN + X 沿用原厂切换顺序；离电时使用节能和普通模式。下方显示 CPU 包的短时与持续功率上限。" Style="{StaticResource Hint}"/>
          <TextBlock x:Name="Refresh" Text="屏幕刷新率" Style="{StaticResource Hint}"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="CPU 最大短时功率（Fast PPT）" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="PowerPeak" Text="正在核对" FontSize="24" Foreground="#A7C5FF"/>
          <TextBlock x:Name="Budget" Style="{StaticResource Hint}"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="散热"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0">
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="性能档风扇曲线" FontSize="18" FontWeight="SemiBold"/>
          <CheckBox x:Name="EnableCurve" Content="接电且使用性能档时启用"/>
          <TextBlock x:Name="FanState" Text="风扇状态" FontSize="15"/>
          <TextBlock x:Name="Thermal" Text="温度 / 风扇" Foreground="#A7C5FF"/>
          <TextBlock Text="温度 °C : 风扇占空比 %，例如 60:55" Style="{StaticResource Hint}"/>
          <TextBox x:Name="Curve" Margin="0,8"/>
          <StackPanel Orientation="Horizontal"><Button x:Name="SaveCurve" Content="保存曲线"/><Button x:Name="Auto" Content="恢复自动风扇"/></StackPanel>
          <TextBlock Text="默认曲线在 85°C 起维持两侧满风扇。普通、节能或离电时恢复自动；进程异常退出由独立看护恢复自动。" Style="{StaticResource Hint}"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="充电"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0">
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="电池状态" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock x:Name="BatteryState" Text="正在读取" FontSize="22" Foreground="#A7C5FF"/>
          <TextBlock x:Name="BatteryCurrent" Style="{StaticResource Hint}"/>
          <TextBlock x:Name="ChargeAvailability" Foreground="#FFCA8D"/>
        </StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="充电上限与暂停" FontSize="17" FontWeight="SemiBold"/>
          <CheckBox x:Name="EnableLimit" Content="限制充电至以下电量"/>
          <TextBlock x:Name="LimitValue" Text="60%" FontSize="24" Foreground="#A7C5FF"/>
          <Slider x:Name="LimitSlider" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,10"/>
          <StackPanel Orientation="Horizontal"><Button x:Name="SaveLimit" Content="应用上限"/><Button x:Name="PauseCharge" Content="暂停充电"/></StackPanel>
          <TextBlock x:Name="ChargePreference" Style="{StaticResource Hint}"/>
          <TextBlock Text="手动暂停独立于上限开关。电量降至上限以下 3 个百分点后允许充电。睡眠、休眠期间软件守护不能运行，唤醒后重新核验。" Style="{StaticResource Hint}"/>
        </StackPanel></Border>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="设置"><StackPanel Margin="0,14,0,0">
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="启动与托盘" FontSize="18" FontWeight="SemiBold"/>
          <CheckBox x:Name="AutoStart" Content="登录 Windows 后自动启用，隐藏至托盘"/>
          <TextBlock x:Name="StartupState" Style="{StaticResource Hint}"/>
          <TextBlock Text="单击右下角托盘图标可唤醒窗口，右键可直接打开各页。关闭或最小化窗口会隐藏到托盘，后台档位提示与风扇控制继续运行。" Style="{StaticResource Hint}"/>
          <TextBlock Text="“退出界面”会移除托盘图标；后台控制继续运行，再次打开任一启动入口即可恢复界面。" Style="{StaticResource Hint}"/>
          <Button x:Name="HidePanel" Content="隐藏到托盘" HorizontalAlignment="Left"/>
        </StackPanel></Border>
      </StackPanel></TabItem>
    </TabControl>
    <TextBlock x:Name="Status" Grid.Row="2" Foreground="#8FD6AF" Text="" Margin="0,12,0,0" MinHeight="18"/>
  </Grid>
</Window>
